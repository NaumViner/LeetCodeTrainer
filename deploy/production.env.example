# Production template. Contains NO real secrets. Do not use unchanged.
# Enter real values in Vercel Environment Variables, or in an ignored local
# .env.production.local file. Never put real values in this tracked template.
# See docs/public-launch-runbook.md. Apply all DB migrations and configure
# Supabase Anonymous Sign-Ins and manual identity linking before launching.

# Production only: exact canonical HTTPS origin, without a trailing slash.
# For Preview, omit NEXT_PUBLIC_APP_URL and use an isolated staging Supabase.
NEXT_PUBLIC_APP_URL=https://replace-with-your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative only; leave empty when using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Gemini key. Verify model access, quotas and billing before launch.
GEMINI_API_KEY=

# Learning coach is outside the primary interview launch flow.
AI_COACH_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=

# Preserve the current post-interview evaluator configuration.
INTERVIEW_EVALUATOR_ENABLED=true
INTERVIEW_EVALUATOR_PROVIDER=gemini
INTERVIEW_EVALUATOR_MODEL=gemini-3.5-flash
INTERVIEW_EVALUATOR_API_KEY=

# Keep existing interview capabilities. The quick-start flow enforces Coverage.
INTERVIEW_SELECTION_MODES_ENABLED=true
INTERVIEW_PROMPT_CONTENT_ENABLED=true
INTERVIEW_CODING_WORKSPACE_ENABLED=true
INTERVIEW_LIVE_STAGE_ENABLED=true
INTERVIEW_FOLLOW_UP_ENABLED=true
INTERVIEW_REVIEW_TIMELINE_ENABLED=true

# Preserve the current live provider/model; names copied from .env.example.
# This template does not verify that the provider grants access to these models.
REALTIME_AI_ENABLED=true
REALTIME_AI_PROVIDER=gemini
REALTIME_AI_MODEL=gemini-3.1-flash-live-preview
REALTIME_AI_API_KEY=
REALTIME_AI_TRANSCRIPTION_MODEL=
REALTIME_AI_VOICE=Kore

ANALYTICS_PROVIDER=

# Anonymous sign-in, identity linking, SMTP and auth rate limits are configured
# in Supabase; inventing environment flags here will not enable those features.

# Public-launch account providers: enable only after configuring and testing them.
AUTH_GOOGLE_ENABLED=false
AUTH_GITHUB_ENABLED=false
# Random server-only credential (at least 32 characters) for daily guest cleanup.
CRON_SECRET=
# Server-only administrative key, used exclusively by scheduled cleanup.
SUPABASE_SERVICE_ROLE_KEY=
