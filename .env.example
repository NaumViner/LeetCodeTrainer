# Canonical HTTPS origin in production. Vercel previews use VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required. Both values are safe to expose to the browser; access remains protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy hosted projects may use the anon key instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional and server-only. The application does not require this key.
SUPABASE_SERVICE_ROLE_KEY=

# One server-only key can power the Gemini coach, evaluator, and live voice.
GEMINI_API_KEY=

# Optional learning coach. Keep every provider key server-only.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=
AI_COACH_ENABLED=true

# Optional post-interview evaluator. Gemini is currently the supported adapter.
INTERVIEW_EVALUATOR_PROVIDER=gemini
INTERVIEW_EVALUATOR_MODEL=gemini-3.5-flash
INTERVIEW_EVALUATOR_API_KEY=
INTERVIEW_EVALUATOR_ENABLED=true

# Independent interview rollout controls. Keep server-only.
INTERVIEW_SELECTION_MODES_ENABLED=true
INTERVIEW_PROMPT_CONTENT_ENABLED=true
INTERVIEW_CODING_WORKSPACE_ENABLED=true

# Optional live voice interviewer. Gemini uses the API free tier when available.
REALTIME_AI_PROVIDER=gemini
REALTIME_AI_MODEL=gemini-3.1-flash-live-preview
REALTIME_AI_API_KEY=
REALTIME_AI_ENABLED=true
REALTIME_AI_TRANSCRIPTION_MODEL=
REALTIME_AI_VOICE=Kore

ANALYTICS_PROVIDER=
