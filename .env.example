# Canonical HTTPS origin in production. Vercel previews use VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required. Both values are safe to expose to the browser; access remains protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy hosted projects may use the anon key instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional and server-only. The application does not require this key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional learning coach. Keep every provider key server-only.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_COACH_ENABLED=false

# Optional live voice interviewer. Requires OpenAI Realtime API access.
REALTIME_AI_PROVIDER=
REALTIME_AI_MODEL=
REALTIME_AI_API_KEY=
REALTIME_AI_ENABLED=false
REALTIME_AI_TRANSCRIPTION_MODEL=
REALTIME_AI_VOICE=

ANALYTICS_PROVIDER=
